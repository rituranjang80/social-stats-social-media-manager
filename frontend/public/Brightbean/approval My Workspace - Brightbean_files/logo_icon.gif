    <script>
        (function() {
            function initWhiteLabel() {
                const isWhiteLabelDomain = !window.location.hostname.includes('.contentstudio.io') && !window.location.hostname.includes('localhost') && !window.location.hostname.includes('contentstudio.local');
                window.isWhiteLabelDomain = isWhiteLabelDomain;

                if (!isWhiteLabelDomain) {
                    document.title = 'ContentStudio - Unified Social Media Management Platform';
                    return;
                }

                document.title = 'App Loading';

                // Prevent search engines from indexing white-label instances
                var noindexMeta = document.createElement('meta');
                noindexMeta.name = 'robots';
                noindexMeta.content = 'noindex, nofollow';
                document.head.appendChild(noindexMeta);

                function updateAllIcons(iconUrl) {
                    const url = iconUrl + '?v=' + new Date().getTime();
                    document.querySelectorAll("link[rel='icon'], link[rel='shortcut icon'], link[rel='apple-touch-icon'], link[rel='apple-touch-icon-precomposed']").forEach(function(link) {
                        link.href = url;
                    });
                    if (!document.querySelector("link[rel='icon']")) {
                        const newLink = document.createElement('link');
                        newLink.rel = 'icon';
                        newLink.href = url;
                        document.head.appendChild(newLink);
                    }
                }

                try {
                    const whiteLabelData = localStorage.getItem('whiteLabelSettings');
                    if (whiteLabelData) {
                        const settings = JSON.parse(whiteLabelData);
                        if (settings.businessName) {
                            document.title = settings.businessName;
                        }
                        if (settings.favicon) {
                            updateAllIcons(settings.favicon);
                        }
                    }
                } catch (error) {
                    console.error("Error applying white label settings:", error);
                }
            }

            initWhiteLabel();
        })();
    </script>


