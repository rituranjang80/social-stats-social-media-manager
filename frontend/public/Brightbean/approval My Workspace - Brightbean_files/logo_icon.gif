<style>
    .loading-logo {
        position: fixed;
        height: 100%;
        width: 100%;
        text-align: center;

        display: flex;
        justify-content: center;
        align-items: center;

    }

    .logo-img {
        position: relative;
        top: 50%;
        transform: translateY(-50%);
    }

     @keyframes bounce {
         0%, 100% {
             transform: translateY(-25%);
             animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
         }
         50% {
             transform: translateY(0);
             animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
         }
     }
</style>
