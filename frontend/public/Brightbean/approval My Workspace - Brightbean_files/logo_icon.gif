<!-- HelpScout Beacon - deferred via requestIdleCallback -->
<script>
  window.Beacon = window.Beacon || function (t, n, a) {
    window.Beacon.readyQueue = window.Beacon.readyQueue || [];
    window.Beacon.readyQueue.push({method: t, options: n, data: a});
  };
  try {
    window.Beacon('init', '626c24ec-ce12-4b02-888b-58f6e82c07f7');
  } catch (e) {
    console.error('Helpscout widget failed to load', e);
  }
  (function() {
    function loadBeacon() {
      var e = document.getElementsByTagName("script")[0], n = document.createElement("script");
      n.type = "text/javascript"; n.defer = true; n.src = "https://beacon-v2.helpscout.net";
      e.parentNode.insertBefore(n, e);
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadBeacon, { timeout: 4000 });
    } else {
      setTimeout(loadBeacon, 3000);
    }
  })();
</script>

