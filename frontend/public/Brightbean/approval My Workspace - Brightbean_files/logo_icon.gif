<div id="app">
    <div id="logo-container" class="loading-logo flex justify-center items-center">
    </div>
</div>
<script>
    // Update loading gif
    (function() {
        const logoContainer = document.getElementById('logo-container');
        if (!logoContainer) return;

        const loaderImage = document.createElement('img');
        loaderImage.id = 'loader-image';
        loaderImage.style.width = '50px'; // Default width
        loaderImage.alt = 'Loading...';   // Default alt text

        // Load white label settings if available
        const whiteLabelData = localStorage.getItem('whiteLabelSettings');
        const settings = whiteLabelData ? JSON.parse(whiteLabelData) : null;

        if (window.isWhiteLabelDomain && settings?.brandLogo) {
            loaderImage.src = settings.brandLogo;
            loaderImage.alt = settings.businessName || loaderImage.alt;
            loaderImage.style.animation = 'bounce 1s infinite';
        } else {
            loaderImage.src = window.isWhiteLabelDomain ? '/default-loader.gif' : "/logo-animation.gif";
            loaderImage.alt = window.isWhiteLabelDomain ? loaderImage.alt : 'ContentStudio';
        }

        // Append the loader image to the logo container
        logoContainer.appendChild(loaderImage);
    })();
</script>


