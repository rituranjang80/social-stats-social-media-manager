# Copy to .env — all runtime configuration lives here (outside the source tree).
# Start stack:  docker compose --env-file .env --env-file paths.env up -d
#
# paths.env defines SOURCE_REL and DATA_REL (see paths.env.example).

COMPOSE_PROJECT_NAME=social-stats

# ── Published ports (host) ────────────────────────────────────────────────────
GATEWAY_HTTP_PORT=8000
BACKEND_DIRECT_PORT=8001
FRONTEND_DEV_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
DEBUGPY_PORT=5678

# ── Runtime mode ─────────────────────────────────────────────────────────────
# dev: Django runserver + optional React dev server (compose.dev.yml)
# prod: Daphne + nginx serving built React (default compose only)
APP_MODE=dev

# Attach debugpy to backend (maps DEBUGPY_PORT). Set WAIT_FOR_DEBUGGER=true to block until IDE connects.
ENABLE_DEBUGPY=false
WAIT_FOR_DEBUGGER=false

# ── Django (injected into backend/celery containers) ─────────────────────────
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,gateway
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# External data paths inside containers (match compose volume mounts)
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/staticfiles
SQLITE_PATH=/data/db.sqlite3

# Browser-reachable gateway (media previews + platform publish URLs) — not Docker service names
BACKEND_PUBLIC_URL=http://localhost:8000
GATEWAY_HTTP_PORT=8000

# Database: leave DB_NAME empty to use SQLite at SQLITE_PATH; set for Postgres service
DB_NAME=
DB_USER=socialstats
DB_PASSWORD=change-me-local
DB_HOST=postgres
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/1

# Frontend (React dev container / build)
REACT_APP_API_URL=http://localhost:8000/api
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Branding — header logo, product name, favicon, browser title (see frontend/.env.example)
REACT_APP_BRAND_NAME=Social Stats
REACT_APP_BRAND_SHORT_NAME=Social Stats
REACT_APP_DOCUMENT_TITLE=Social Stats — The marketing OS for modern teams
REACT_APP_BRAND_DESCRIPTION=Social Stats — the marketing OS for modern teams. Manage analytics, content, conversations, and ads across Facebook, Instagram, YouTube, LinkedIn, and Google Business in one place.
REACT_APP_BRAND_LOGO_URL=
REACT_APP_FAVICON_URL=/icons/icon-192.png
REACT_APP_APPLE_TOUCH_ICON_URL=/apple-touch-icon.png
REACT_APP_BRAND_PRIMARY_COLOR=#00CCF5

# Gateway nginx: dev proxies SPA to frontend container; prod serves static build
NGINX_MODE=dev

# Kubernetes only (scripts/k8s-deploy.ps1 reads these)
K8S_NAMESPACE=social-stats
K8S_SOURCE_HOST_PATH=
K8S_DATA_HOST_PATH=

# ── Backup (Docker scheduled sidecar + optional host script) ─────────────────
# Docker: enable profile backup — see docs/backup.md
#   docker compose --profile backup up -d backup
#   .\scripts\run-backup-docker.ps1 -Once
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
# Paths INSIDE the backup container (after volume mounts below)
BACKUP_DESTINATIONS=/backups/mount1;/backups/mount2;/data/backups/archive
BACKUP_STAGING_DIR=/data/backups/staging
BACKUP_LABEL=social-stats
BACKUP_COMPRESS=true
BACKUP_VERIFY=true
BACKUP_INCLUDE_SQLITE=true
BACKUP_INCLUDE_POSTGRES=true
BACKUP_INCLUDE_MEDIA=true
BACKUP_INCLUDE_STATICFILES=false
BACKUP_EXTRA_PATHS=
# Cron (UTC): minute hour dom month dow — default daily 02:00 UTC
BACKUP_CRON=0 2 * * *
BACKUP_RUN_ON_START=false
# Host folders → container /backups/mountN (UNC or mapped drive, e.g. Z:\Backups\Post4U)
BACKUP_MOUNT_1_HOST=./data/backups/mount1
BACKUP_MOUNT_2_HOST=./data/backups/mount2
BACKUP_MOUNT_3_HOST=./data/backups/mount3
BACKUP_MOUNT_4_HOST=./data/backups/mount4
BACKUP_MOUNT_5_HOST=./data/backups/mount5
# Example network share (Windows: map drive first, then use Z:\...)
# BACKUP_MOUNT_1_HOST=\\YOUR-NAS\social-stats-backups
# BACKUP_MOUNT_2_HOST=Z:\social-stats-backups
# When using Postgres in Docker, backup container uses service name postgres:
BACKUP_DB_HOST=postgres

