# syntax=docker/dockerfile:1
# Scheduled backup sidecar — build from start folder; app source via additional_contexts.app
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BACKUP_IN_DOCKER=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    cron \
    postgresql-client \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=app scripts/backup /app/scripts/backup
COPY --from=app scripts/run_backup.py /app/scripts/run_backup.py
COPY docker/entrypoint-backup.sh /entrypoint-backup.sh

RUN sed -i 's/\r$//' /entrypoint-backup.sh && chmod +x /entrypoint-backup.sh

ENTRYPOINT ["/bin/bash", "/entrypoint-backup.sh"]
