# Copy to .env — all runtime configuration lives here (outside the source tree).
# Start stack:  docker compose --env-file .env --env-file paths.env up -d
#
# paths.env defines SOURCE_REL and DATA_REL (see paths.env.example).

COMPOSE_PROJECT_NAME=social-stats

# ── Published ports (host) ────────────────────────────────────────────────────
GATEWAY_HTTP_PORT=8000
BACKEND_DIRECT_PORT=8001
FRONTEND_DEV_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
DEBUGPY_PORT=5678

# ── Runtime mode ─────────────────────────────────────────────────────────────
# dev: Django runserver + optional React dev server (compose.dev.yml)
# prod: Daphne + nginx serving built React (default compose only)
APP_MODE=dev

# Attach debugpy to backend (maps DEBUGPY_PORT). Set WAIT_FOR_DEBUGGER=true to block until IDE connects.
ENABLE_DEBUGPY=false
WAIT_FOR_DEBUGGER=false

# ── Django (injected into backend/celery containers) ─────────────────────────
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,gateway
FRONTEND_URL=http://localhost:3000
# Public base URL for /media/... when publishing to Meta/LinkedIn (Instagram needs HTTPS in prod).
# Celery YouTube uploads read from MEDIA_ROOT when the file exists; this URL is the HTTP fallback.
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# External data paths inside containers (match compose volume mounts)
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/staticfiles
SQLITE_PATH=/data/db.sqlite3

# Database: leave DB_NAME empty to use SQLite at SQLITE_PATH; set for Postgres service
DB_NAME=
DB_USER=socialstats
DB_PASSWORD=change-me-local
DB_HOST=postgres
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/1

# Frontend (React dev container / build)
REACT_APP_API_URL=http://localhost:8000/api
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# White-label branding (also set in ../frontend/.env — that file is loaded by compose dev)
REACT_APP_BRAND_NAME=post4u
REACT_APP_BRAND_SHORT_NAME=post4u
REACT_APP_DOCUMENT_TITLE=post4u — Social media management
REACT_APP_BRAND_DESCRIPTION=post4u — social media management for agencies and businesses.
REACT_APP_BRAND_LOGO_URL=
REACT_APP_FAVICON_URL=/icons/icon-192.png
REACT_APP_APPLE_TOUCH_ICON_URL=/apple-touch-icon.png
REACT_APP_BRAND_PRIMARY_COLOR=#00CCF5

# Gateway nginx: dev proxies SPA to frontend container; prod serves static build
NGINX_MODE=dev

# Kubernetes only (scripts/k8s-deploy.ps1 reads these)
K8S_NAMESPACE=social-stats
K8S_SOURCE_HOST_PATH=
K8S_DATA_HOST_PATH=
