# Copy to paths.env and adjust for your machine (paths are relative to this folder).
# Used by Docker Compose and Kubernetes overlays — not committed with secrets.

# Application source checkout.
# In-repo layout (this start folder lives inside the repo): SOURCE_REL=..
# Sibling layout (start folder next to the repo checkout): SOURCE_REL=../social-stats-social-media-manager
SOURCE_REL=../social-stats-social-media-manager

# This deployment folder (usually ".").
START_REL=.

# Persistent runtime data (SQLite, uploads, static collect output).
DATA_REL=./data
